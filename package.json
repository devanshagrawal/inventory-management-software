{
  "name": "inventory-soft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:standalone": "next build && node electron/copy-assets.mjs",
    "electron:dev": "electron electron/main.mjs",
    "native:rebuild": "node electron/rebuild-native.mjs",
    "electron:build:mac": "npm run build:standalone && electron-builder --mac --publish never",
    "electron:build:win": "npm run build:standalone && electron-builder --win --publish never",
    "electron:build": "npm run build:standalone && electron-builder --mac --win --publish never",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.6.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "get-port": "^7.2.0",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "png2icons": "^2.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.devanshagrawal.inventory-dashboard",
    "productName": "Inventory Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.mjs",
      "!src/**/*",
      "!prisma/**/*",
      "!.next/**/*",
      "!public/**/*",
      "!electron/icons/**/*",
      "!electron/prebuilt/**/*",
      "!electron/*.svg"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": "next-build",
        "filter": ["standalone/**/*"]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "electron/icons/icon.icns",
      "identity": null,
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
